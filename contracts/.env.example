# Deployer: owns FamiliarRegistry admin roles + familiar.eth, owns FamiliarFeeder. Needs Sepolia ETH,
# a little Base ETH, and a little 0G on 0G mainnet.
PRIVATE_KEY=
# Backend key: writes avatar/mood/day text records, logs days on 0G, and (by default) hatches/renews.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=
# Optional separate hatch/renew key (defaults to AGENT_ADDRESS)
OPERATOR_ADDRESS=
# Parent name on Sepolia ENSv2 (familiar -> familiar.eth)
FAMILIAR_PARENT_LABEL=familiar
# Optional: fixed W0G price per visit (wei); default = 90% of a live $1 quote
FEEDER_PRICE_W0G=

SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC=https://base-rpc.publicnode.com
ZG_RPC=https://evmrpc.0g.ai

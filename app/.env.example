# ---- Required --------------------------------------------------------------------------------
APP_URL=http://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32, prefixed with 0x. Encrypts every Familiar's memory. Never rotate casually.
MEMORY_MASTER_KEY=
# Agent key (writes avatar/mood/day ENS records, logs days on 0G Chain, hatches/renews).
# Must match the AGENT baked into FamiliarRegistry/FamiliarLog: 0xabE4503667aDd82BB41fd042FD0e534eA5D1eD23
AGENT_PRIVATE_KEY=
# Postgres in production (Neon/Supabase/etc). Unset in dev = embedded PGlite in .data/pglite
DATABASE_URL=

# ---- 0G Private Computer (https://pc.0g.ai → API Keys) --------------------------------------
ZG_API_KEY=
# ZG_ROUTER_URL=https://router-api.0g.ai/v1
# ZG_MODEL_STT=whisper-large-v3
# ZG_MODEL_CHAT=0gm-1.0-35b-a3b
# ZG_MODEL_IMAGE=bytedance/seedream-5.0-flash
# ZG_MODEL_VIDEO=bytedance/seedance-2.0-fast
# ZG_VERIFY_TEE=true
# Upload the encrypted memory to 0G Storage (agent wallet pays a tiny fee in 0G)
ZG_STORAGE_ENABLED=false

# ---- iAI sign-in (0G's Privy app ID — localhost:3000/3001/5173 only) --------------------------
PRIVY_APP_ID=

# ---- Uniswap Trading API (https://developers.uniswap.org) -----------------------------------
UNISWAP_API_KEY=
# FEED_SLIPPAGE_PCT=1

# ---- Media (portraits/voice/clips). Required in production. ----------------------------------
BLOB_READ_WRITE_TOKEN=
# Serve media from local disk even in production (single machine / local testing only)
# ALLOW_LOCAL_MEDIA=false

# ---- Voice + evolution clips ------------------------------------------------------------------
# ZG_TTS_ENABLED=true
# ZG_MODEL_TTS=minimax-speech-2.8-turbo
# ZG_TTS_VOICE=English_Graceful_Lady
# ZG_VIDEO_RESOLUTION=480p

# ---- Night walks + push notifications --------------------------------------------------------
# Team-paid night-walk paintings allowed per UTC day across all users
# WALKS_PER_DAY=100
# Web Push (VAPID). Leave both keys unset to turn push notifications off (GET /api/push/key → null).
# Generate a pair with: npx web-push generate-vapid-keys  (never commit the private key)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: https: URL or mailto:. Defaults to APP_URL (mailto fallback when APP_URL is http)
# VAPID_SUBJECT=mailto:you@example.com

# ---- Ops -------------------------------------------------------------------------------------
CRON_SECRET=
# Labels that are free and exempt from one-visit-per-day (e.g. a seeded demo Familiar)
DEMO_LABELS=
# POST /api/auth/demo signs in as the first demo label's owner without a signature
# DEMO_LOGIN_ENABLED=false
# Team-paid hatches allowed per UTC day; gas warnings below these agent balances
# FREE_HATCHES_PER_DAY=50
# AGENT_MIN_BALANCE_SEPOLIA=0.01
# AGENT_MIN_BALANCE_ZG=0.1
# SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# BASE_RPC=https://base-rpc.publicnode.com
# ZG_RPC=https://evmrpc.0g.ai

# Same value as PRIVY_APP_ID, exposed to the browser for the Privy login
NEXT_PUBLIC_PRIVY_APP_ID=
# Public URL of the frontend (wallet metadata).
NEXT_PUBLIC_APP_URL=
# Reown (WalletConnect) project id — enables mobile wallets via QR. https://dashboard.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Event spotlights (Devcon 8, ETHGlobal Mumbai, Diwali): pretend today is this UTC date (YYYY-MM-DD)
# for event status, the 2× visit Sparks bonus and event quests. Unset = the real date.
# EVENTS_TODAY=2026-11-06

# Seasonal event for the UI: auto | diwali | none (server: FESTIVAL)
FESTIVAL=auto
NEXT_PUBLIC_FESTIVAL=auto

# --- Split deploy (frontend on Vercel, API on Railway) ---
# Frontend only: proxy every /api/* request to the API server.
BACKEND_URL=
# API server only: local media on a mounted volume, and the in-process reconcile job
# (retries chain writes, fails stuck night walks, expires trades, sends "I need you" pushes).
MEDIA_DIR=
INTERNAL_CRON=false

# Extra hosts that serve /api/media (comma-separated), e.g. a previous domain.
MEDIA_HOSTS=

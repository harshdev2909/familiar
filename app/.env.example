# ---- Required --------------------------------------------------------------------------------
APP_URL=http://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 32, prefixed with 0x. Encrypts every Familiar's memory. Never rotate casually.
MEMORY_MASTER_KEY=
# Agent key (writes avatar/mood/day ENS records, logs days on 0G Chain, hatches/renews).
# Must match the AGENT baked into FamiliarRegistry/FamiliarLog: 0xabE4503667aDd82BB41fd042FD0e534eA5D1eD23
AGENT_PRIVATE_KEY=
# Postgres in production (Neon/Supabase/etc). Unset in dev = embedded PGlite in .data/pglite
DATABASE_URL=

# ---- 0G Private Computer (https://pc.0g.ai → API Keys) --------------------------------------
ZG_API_KEY=
# ZG_ROUTER_URL=https://router-api.0g.ai/v1
# ZG_MODEL_STT=whisper-large-v3
# ZG_MODEL_CHAT=0gm-1.0-35b-a3b
# ZG_MODEL_IMAGE=bytedance/seedream-5.0-flash
# ZG_MODEL_VIDEO=bytedance/seedance-2.0-fast
# ZG_VERIFY_TEE=true
# Upload the encrypted memory to 0G Storage (agent wallet pays a tiny fee in 0G)
ZG_STORAGE_ENABLED=false

# ---- iAI sign-in (0G's Privy app ID — localhost:3000/3001/5173 only) --------------------------
PRIVY_APP_ID=

# ---- Uniswap Trading API (https://developers.uniswap.org) -----------------------------------
UNISWAP_API_KEY=
# FEED_SLIPPAGE_PCT=1

# ---- Media (portraits/clips). Required in production. ----------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---- Ops -------------------------------------------------------------------------------------
CRON_SECRET=
# Labels exempt from one-visit-per-day (e.g. a seeded demo Familiar)
DEMO_LABELS=
